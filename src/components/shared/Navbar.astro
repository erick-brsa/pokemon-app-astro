---
const links = [
    { href: "/", text: "Listado" },
    { href: "/pokemons/1", text: "Paginado" },
    { href: "/favorites", text: "Favoritos" },
    { href: "/islands", text: "islas" }
];

const { pathname } = Astro.url;
---

<nav class="shadow bg-slate-800">
    <div
        class="container flex items-center justify-center p-6 mx-auto text-gray-600 capitalize dark:text-gray-300"
    >
        <!-- {
            links.map(({ href, text }) => (
                <a
                    href={href}
                    class:list={[
                            'text-gray-200 mx-1.5 sm:mx-6',
                            (pathname === href) && 'border-b-2 border-blue-500'

                    ]}
                    transition:name={`${text}-link`}
                >
                    {text}
                </a>
            ))
        } -->
        {
            links.map(({ href, text }) => (
                <div class="">
                    <a
                        href={href}
                        class="text-gray-200 mx-1.5 sm:mx-6"
                        >
                        {text}
                    </a>
                    {(pathname === href) ? (
                        <div class="border-b-2 border-blue-500 mx-5"
                            transition:name="menu-line"
                        />
                    ) : (
                        <div class="border-2 border-transparent"/>
                    )}
                </div>
            ))
        }
    </div>
</nav>

