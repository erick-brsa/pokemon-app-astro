---
interface Props {
    name: string;
    url: string;
    isBig?: boolean;
}

const { name, url, isBig = false } = Astro.props;
const id = url.split("/").at(-2);
// const imageUrl = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/showdown/${id}.gif`
const imageUrl = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;
---

<a
    href={`/pokemons/${name}`}
    
    class:list={[
        "flex flex-col justify-center items-center",
        {
            "bg-slate-700 rounded-lg my-4  relative pt-6 px-2 pb-2": !isBig
        }
    ]}
>
    <img
        src={imageUrl}
        alt={`Pokemon ${name}`}
        transition:name={`${name}-image`}
    />
    <h3
        class:list={[
            "capitalize",
            {
                "text-3xl font-bold text-blue-400": isBig,
            },
        ]}
    >
        <!-- {isBig && `#${id}`} -->
        {name}
    </h3>
    {
        !isBig && (
            <div
                class="absolute top-0 right-0 p-2 bg-slate-200/5 w-10 flex justify-center backdrop-blur-sm rounded-bl-2xl"
            >
                {id}
            </div>
        )
    }
</a>
